# GeoAirQuality API — local environment template
# ------------------------------------------------
# Copy to api/.env and fill in real values. NEVER commit .env.
# `setup-dev.sh` generates a working api/.env automatically.
#
# SECURITY NOTES:
#   - main.py uses a SYNC engine (psycopg2): DATABASE_URL must be
#     postgresql:// — postgresql+asyncpg:// crashes startup.
#   - The local dev default password below is for local docker-compose
#     only; production passwords live in a k8s Secret, never in git.

# PostGIS connection (docker-compose maps host port 5433)
DATABASE_URL=postgresql://geoair_user:geoair_pass@localhost:5433/geoairquality

# Redis cache (docker-compose maps host port 6380)
REDIS_URL=redis://localhost:6380/0

# App
LOG_LEVEL=INFO
ENVIRONMENT=development
# JWT/auth signing key — generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# News sources (optional — fetchers skip cleanly when empty)
AIRNOW_API_KEY=
NEWSAPI_KEY=

# News scheduler
NEWS_FETCH_INTERVAL_MINUTES=30
NEWS_RETENTION_DAYS=7

# CORS (dev)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
