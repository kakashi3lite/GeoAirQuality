[flake8]
max-line-length = 100
# macOS AppleDouble metadata (external/exFAT volumes) breaks the parser —
# always exclude; do not follow symlinks.
exclude =
    .git,
    ._*,
    __pycache__,
    .pytest_cache,
    node_modules,
    .venv,
    venv
# E203/E501 are incompatible with black's formatting; W503 conflicts with black.
extend-ignore = E203,W503
# Tests intentionally insert sys.path before imports (standalone runnable).
per-file-ignores =
    tests/*:E402
